# Agent instructions — not a project artifact.
# In the TEMPLATE itself, CLAUDE.md is force-added (git add -f): it is the entry point.
# In a workspace unpacked from the template, this rule behaves as intended.
CLAUDE.md
AGENTS.md
.cursorrules
*-plan.md
*-scratch.md

# Credentials
.mcp.json

# Figma export cache
.figma-cache/

# Exports: assets are binaries; tokens are versioned or not, decided at init
exports/assets/
# exports/tokens/   ← uncomment if tokens are not versioned here

# Designs and mockups live in Figma
*.fig
*.sketch
*.png
*.jpg
*.jpeg
*.pdf

# The code repository is attached as a symlink
code/

# Specs in Obsidian (uncommented by init when a vault is chosen)
# /specs

.claude/*
!.claude/agents/
!.claude/commands/
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
!.claude/settings.local.json.example
.claude/settings.local.json

error.log
*.log
node_modules/
.DS_Store
**/.DS_Store
