{
  "_comment": "Copy to .mcp.json and substitute the token. .mcp.json is gitignored — it carries credentials.",
  "mcpServers": {
    "figma": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp",
        "--figma-api-key=YOUR_FIGMA_TOKEN",
        "--stdio"
      ]
    }
  }
}
